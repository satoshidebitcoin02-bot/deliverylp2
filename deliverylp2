<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PediPronto | O Cardápio Digital que facilita seu negócio</title>
<meta name="description" content="Cardápio digital com pedidos no WhatsApp, pagamento via Mercado Pago e Pix. Seu pedido na hora, sem complicação. Feito para lanchonetes, pizzarias, açaiterias e mais.">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Raleway:wght@600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --laranja:#FF5A1F;
  --laranja-escuro:#E8430C;
  --vermelho:#E8302F;
  --vermelho-claro:#FF4D4D;
  --laranja-claro:#FF7A45;
  --amarelo:#FFB020;
  --amarelo-claro:#FFC94D;
  --preto:#1A1410;
  --grafite:#2A211B;
  --cinza:#6B5D52;
  --cinza-claro:#9A8D82;
  --creme:#FFF7F0;
  --branco:#ffffff;
  --verde-zap:#25D366;
  --radius:20px;
  --sombra:0 18px 50px -20px rgba(232,67,12,.45);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Outfit',sans-serif;color:var(--preto);background:var(--branco);line-height:1.6;overflow-x:hidden}
h1,h2,h3,.logo-text{font-family:'Raleway',sans-serif;line-height:1.1}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
.container{width:100%;max-width:1180px;margin:0 auto;padding:0 22px}
.pulse{animation:pulse 2.4s infinite}
@keyframes pulse{0%{transform:scale(1)}50%{transform:scale(1.035)}100%{transform:scale(1)}}
@keyframes floaty{0%{transform:translateY(0)}50%{transform:translateY(-12px)}100%{transform:translateY(0)}}
.reveal{opacity:0;transform:translateY(28px);transition:all .7s cubic-bezier(.16,1,.3,1)}
.reveal.in{opacity:1;transform:none}
.eyebrow{font-weight:700;font-size:.82rem;letter-spacing:2px;text-transform:uppercase;color:var(--laranja);margin-bottom:14px}

/* NAVBAR */
header{position:fixed;top:0;left:0;width:100%;z-index:1000;transition:all .35s ease;padding:14px 0}
header.scrolled{background:rgba(255,255,255,.9);backdrop-filter:blur(18px) saturate(180%);box-shadow:0 8px 30px -18px rgba(0,0,0,.3)}
.nav{display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px}
.brand img{height:46px;width:auto}
.nav-links{display:flex;align-items:center;gap:30px}
.nav-links a{font-size:.93rem;font-weight:600;color:#fff;transition:color .2s}
header.scrolled .nav-links a{color:var(--grafite)}
.nav-links a:hover{color:var(--amarelo)}
header.scrolled .nav-links a:hover{color:var(--laranja)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-family:'Outfit',sans-serif;font-weight:600;font-size:.98rem;padding:13px 26px;border-radius:50px;border:none;cursor:pointer;transition:transform .2s,box-shadow .25s}
.btn-zap{background:var(--verde-zap);color:#fff;box-shadow:0 12px 28px -12px rgba(37,211,102,.7)}
.btn-zap:hover{transform:translateY(-2px)}
.btn-laranja{background:linear-gradient(135deg,var(--laranja),var(--laranja-escuro));color:#fff;box-shadow:var(--sombra)}
.btn-laranja:hover{transform:translateY(-2px)}
.btn-branco{background:#fff;color:var(--laranja-escuro);box-shadow:0 10px 26px -14px rgba(0,0,0,.35)}
.btn-branco:hover{transform:translateY(-2px)}
.btn-ghost{background:#fff;color:var(--grafite);box-shadow:0 8px 24px -14px rgba(0,0,0,.3)}
.btn-ghost:hover{transform:translateY(-2px)}
.btn svg{width:20px;height:20px}
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:8px;z-index:1100}
.hamburger span{width:26px;height:3px;background:#fff;border-radius:3px;transition:all .3s}
header.scrolled .hamburger span{background:var(--preto)}
.hamburger.open span{background:var(--preto)}
.hamburger.open span:nth-child(1){transform:translateY(8px) rotate(45deg)}
.hamburger.open span:nth-child(2){opacity:0}
.hamburger.open span:nth-child(3){transform:translateY(-8px) rotate(-45deg)}

/* MOBILE MENU */
.mobile-menu{position:fixed;inset:0;z-index:1050;background:rgba(26,20,16,.55);backdrop-filter:blur(5px);opacity:0;visibility:hidden;transition:all .35s}
.mobile-menu.open{opacity:1;visibility:visible}
.mobile-drawer{position:absolute;top:0;right:0;height:100%;width:78%;max-width:310px;background:rgba(255,247,240,.85);backdrop-filter:blur(28px) saturate(200%);border-left:1px solid rgba(255,176,32,.4);box-shadow:-20px 0 60px -30px rgba(0,0,0,.5);padding:90px 30px 30px;display:flex;flex-direction:column;gap:8px;transform:translateX(100%);transition:transform .42s cubic-bezier(.16,1,.3,1)}
.mobile-menu.open .mobile-drawer{transform:translateX(0)}
.mobile-drawer a{padding:14px 6px;font-weight:600;font-size:1.08rem;border-bottom:1px solid rgba(0,0,0,.06);color:var(--grafite)}
.mobile-drawer .btn{margin-top:18px}
.drawer-close{position:absolute;top:24px;right:24px;background:none;border:none;cursor:pointer;font-size:1.8rem;color:var(--grafite);line-height:1}

/* HERO */
.hero{position:relative;padding:130px 0 90px;overflow:hidden;background:linear-gradient(120deg,var(--laranja) 0%,var(--laranja-escuro) 55%,var(--vermelho) 100%)}
.hero::before{content:"";position:absolute;top:-20%;right:-10%;width:60%;height:140%;background:linear-gradient(160deg,var(--amarelo),var(--laranja-claro));transform:skewX(-12deg);opacity:.55;z-index:0}
.hero::after{content:"";position:absolute;bottom:-40px;left:0;width:100%;height:80px;background:#fff;clip-path:polygon(0 60%,100% 0,100% 100%,0 100%)}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(2.6rem,5vw,4.1rem);font-weight:900;letter-spacing:-1.5px;margin-bottom:20px;color:#fff}
.hero h1 .amar{color:var(--amarelo-claro)}
.hero p.sub{font-size:1.12rem;color:rgba(255,255,255,.92);max-width:500px;margin-bottom:30px;font-weight:500}
.hero-cta{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.hero-social{display:flex;gap:14px;margin-top:30px}
.hero-social a{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;transition:background .2s}
.hero-social a:hover{background:rgba(255,255,255,.35)}
.hero-social svg{width:19px;height:19px;color:#fff}

/* PHONE MOCKUP */
.phone-wrap{display:flex;justify-content:center;position:relative}
.phone{position:relative;z-index:2;width:290px;background:#1A1410;border-radius:40px;padding:11px;box-shadow:0 40px 90px -30px rgba(0,0,0,.55),0 0 0 2px rgba(255,255,255,.15);animation:floaty 5s ease-in-out infinite}
.phone-screen{background:#fff;border-radius:30px;overflow:hidden;height:540px;display:flex;flex-direction:column}
.ps-head{background:linear-gradient(135deg,var(--laranja),var(--vermelho));padding:16px 15px 13px;position:relative}
.ps-head .store{display:flex;align-items:center;gap:10px}
.ps-logo{width:44px;height:44px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:1.3rem;box-shadow:0 4px 10px -4px rgba(0,0,0,.25)}
.ps-head h4{font-family:'Outfit';font-weight:700;font-size:.98rem;color:#fff}
.ps-head small{font-size:.72rem;color:rgba(255,255,255,.85)}
.ps-tag{display:inline-block;margin-top:7px;background:#fff;color:var(--laranja-escuro);font-size:.64rem;font-weight:700;padding:4px 10px;border-radius:20px}
.ps-body{flex:1;overflow:hidden;padding:13px 13px 0}
.ps-sec{font-size:.68rem;font-weight:700;color:#9a8d82;letter-spacing:.5px;text-transform:uppercase;margin:5px 0 9px}
.ps-item{display:flex;gap:10px;align-items:center;padding:9px;border:1px solid #f0e6dd;border-radius:13px;margin-bottom:9px;background:#fff}
.ps-thumb{width:46px;height:46px;border-radius:10px;background:linear-gradient(135deg,var(--amarelo),var(--laranja));flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:1.25rem}
.ps-info{flex:1;min-width:0}
.ps-info b{font-size:.82rem;font-weight:600;color:#2A211B;display:block}
.ps-info span{font-size:.69rem;color:#9a8d82;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ps-info .pr{color:var(--laranja-escuro);font-weight:700;font-size:.8rem;margin-top:2px}
.ps-add{width:25px;height:25px;border-radius:50%;background:var(--laranja);color:#fff;border:none;font-size:1.05rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer}
.ps-foot{background:var(--laranja);color:#fff;padding:12px 15px;display:flex;justify-content:space-between;align-items:center;font-size:.8rem;font-weight:600}

/* NICHOS */
.nichos{padding:34px 0;background:#fff;border-bottom:1px solid rgba(0,0,0,.05)}
.nichos-row{display:flex;flex-wrap:wrap;justify-content:center;gap:13px}
.nicho-pill{display:flex;align-items:center;gap:8px;background:var(--creme);padding:10px 18px;border-radius:50px;font-weight:600;font-size:.93rem;color:var(--grafite);border:1px solid rgba(255,90,31,.12)}
.nicho-pill i{font-size:1.1rem}

/* SECTION */
section.block{padding:84px 0}
.sec-head{max-width:680px;margin:0 auto 50px}
.sec-head.center{text-align:center}
.sec-head h2{font-size:clamp(1.8rem,3.4vw,2.6rem);font-weight:800;letter-spacing:-1px;margin-bottom:14px}
.sec-head h2 .grad{background:linear-gradient(120deg,var(--laranja),var(--amarelo));-webkit-background-clip:text;background-clip:text;color:transparent}
.sec-head p{color:var(--cinza);font-size:1.06rem}

/* IMPRESSAO */
.print-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}
.print-visual{position:relative;display:flex;justify-content:center}
.print-blob{position:absolute;inset:0;background:radial-gradient(circle at center,rgba(255,90,31,.18),transparent 65%);border-radius:30px}
.printer{position:relative;z-index:2;width:280px;background:linear-gradient(160deg,#2A211B,#1A1410);border-radius:22px;padding:24px 22px 30px;box-shadow:0 30px 70px -30px rgba(0,0,0,.5)}
.receipt{background:#fff;border-radius:6px 6px 0 0;padding:16px 14px;font-family:'Courier New',monospace;font-size:.66rem;color:#333;line-height:1.5;box-shadow:0 -6px 20px -8px rgba(0,0,0,.3);position:relative}
.receipt::after{content:"";position:absolute;bottom:-6px;left:0;width:100%;height:7px;background:repeating-linear-gradient(135deg,#fff 0 6px,transparent 6px 12px)}
.receipt b{font-size:.72rem}
.receipt .line{border-top:1px dashed #bbb;margin:6px 0}
.printer-slot{height:14px;background:#0e0b08;border-radius:4px;margin-top:18px}
.printer-leds{display:flex;gap:7px;margin-top:14px;justify-content:center}
.printer-leds span{width:9px;height:9px;border-radius:50%;background:var(--laranja);box-shadow:0 0 8px var(--laranja)}
.printer-leds span:nth-child(2){background:var(--amarelo);box-shadow:0 0 8px var(--amarelo)}
.printer-leds span:nth-child(3){background:#444;box-shadow:none}
.print-text .down{display:flex;flex-direction:column;gap:12px;margin-top:22px}
.print-text .down a{display:flex;align-items:center;gap:11px;font-weight:600;color:var(--grafite);font-size:.98rem}
.print-text .down .ic{width:38px;height:38px;border-radius:11px;background:var(--creme);display:flex;align-items:center;justify-content:center;color:var(--laranja)}
.print-text .down .ic svg{width:20px;height:20px}

/* COMO FUNCIONA */
.steps{display:flex;flex-direction:column;gap:6px;max-width:760px}
.step-row{display:flex;gap:22px;align-items:flex-start;padding:18px 0;position:relative}
.step-num{flex-shrink:0;width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--laranja),var(--laranja-escuro));color:#fff;font-family:'Raleway';font-weight:900;font-size:1.5rem;box-shadow:var(--sombra)}
.step-row .st-body h3{font-size:1.18rem;font-weight:700;margin-bottom:5px}
.step-row .st-body p{color:var(--cinza);font-size:.97rem}
.step-line{position:absolute;left:27px;top:62px;bottom:-6px;width:2px;background:linear-gradient(var(--laranja),rgba(255,90,31,.15))}
.step-row:last-child .step-line{display:none}

/* RECURSOS */
.recursos-sec{position:relative;background:var(--creme)}
.recursos-sec::before{content:"";position:absolute;top:0;left:0;width:100%;height:90px;background:#fff;clip-path:polygon(0 0,100% 0,100% 0,0 100%)}
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px 40px;position:relative;z-index:2}
.feat-card .feat-ico{width:54px;height:54px;border-radius:15px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--laranja),var(--vermelho));margin-bottom:16px;box-shadow:0 12px 26px -14px rgba(232,48,47,.6)}
.feat-card .feat-ico svg{width:26px;height:26px;color:#fff}
.feat-card h3{font-size:1.12rem;font-weight:700;margin-bottom:8px}
.feat-card p{font-size:.95rem;color:var(--cinza)}

/* VIDEO */
.video-wrap{max-width:880px;margin:0 auto}
.video-box{position:relative;border-radius:22px;overflow:hidden;cursor:pointer;box-shadow:0 30px 70px -30px rgba(232,67,12,.45);aspect-ratio:16/9;background:#1A1410}
.video-thumb{position:absolute;inset:0;display:flex;flex-direction:column;background:linear-gradient(135deg,#2A211B,#1A1410)}
.vt-bar{height:38px;background:#0e0b08;display:flex;align-items:center;gap:7px;padding:0 16px}
.vt-bar span{width:11px;height:11px;border-radius:50%;background:#444}
.vt-bar span:nth-child(1){background:#FF5F57}
.vt-bar span:nth-child(2){background:#FEBC2E}
.vt-bar span:nth-child(3){background:#28C840}
.vt-bar .vt-url{width:auto;height:auto;border-radius:8px;background:#1f1a15;color:#9A8D82;font-size:.72rem;font-family:'Outfit';padding:4px 16px;margin-left:14px}
.vt-screen{flex:1;display:flex;background:#f7f1ea}
.vt-side{width:22%;background:linear-gradient(180deg,var(--laranja),var(--laranja-escuro))}
.vt-main{flex:1;padding:22px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start}
.vt-card{height:54px;border-radius:10px;background:#fff;box-shadow:0 6px 16px -10px rgba(0,0,0,.25)}
.vt-card.wide{grid-column:span 2;height:40px;background:linear-gradient(135deg,rgba(255,90,31,.18),rgba(255,176,32,.12))}
.play-btn{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:84px;height:84px;border-radius:50%;border:none;cursor:pointer;background:linear-gradient(135deg,var(--laranja),var(--laranja-escuro));box-shadow:0 18px 44px -14px rgba(232,67,12,.8);display:flex;align-items:center;justify-content:center;transition:transform .25s;animation:pulse 2.4s infinite}
.play-btn:hover{transform:translate(-50%,-50%) scale(1.08)}
.play-btn svg{width:38px;height:38px;color:#fff;margin-left:5px}
.video-label{position:absolute;bottom:16px;right:18px;background:rgba(26,20,16,.7);color:#fff;font-size:.78rem;font-weight:600;padding:6px 14px;border-radius:50px;backdrop-filter:blur(6px)}
.video-box iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

/* FOQUE */
.foque{position:relative;border-radius:0;padding:90px 0;background:linear-gradient(rgba(20,16,12,.86),rgba(20,16,12,.92)),url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40"><rect width="40" height="40" fill="%231a1410"/></svg>');background-size:cover;background-position:center;color:#fff;overflow:hidden}
.foque::before{content:"";position:absolute;top:-30%;right:-10%;width:50%;height:160%;background:radial-gradient(circle,rgba(255,90,31,.35),transparent 60%);filter:blur(40px)}
.foque-ico{width:60px;height:60px;border-radius:16px;background:linear-gradient(135deg,var(--laranja),var(--vermelho));display:flex;align-items:center;justify-content:center;margin-bottom:22px;box-shadow:var(--sombra)}
.foque-ico svg{width:30px;height:30px;color:#fff}
.foque-inner{position:relative;z-index:2;max-width:560px}
.foque h2{font-size:clamp(1.9rem,3.6vw,2.8rem);font-weight:800;letter-spacing:-1px;margin-bottom:18px}
.foque h2 .grad{background:linear-gradient(120deg,var(--amarelo),var(--laranja-claro));-webkit-background-clip:text;background-clip:text;color:transparent}
.foque p{color:rgba(255,255,255,.82);margin-bottom:28px;font-size:1.06rem}

/* PLANOS */
.planos{display:flex;justify-content:center;gap:24px;align-items:flex-start;flex-wrap:wrap;max-width:820px;margin:0 auto}
.plano{background:#fff;border-radius:var(--radius);padding:36px 30px;box-shadow:0 20px 50px -30px rgba(0,0,0,.22);border:2px solid rgba(255,90,31,.1);display:flex;flex-direction:column;flex:1;min-width:300px;transition:transform .3s}
.plano:hover{transform:translateY(-6px)}
.plano.dest{border-color:var(--laranja);background:linear-gradient(180deg,#fff,#FFF3EC);box-shadow:0 30px 70px -30px rgba(232,67,12,.45);position:relative}
.plano-tag{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--laranja),var(--laranja-escuro));color:#fff;font-size:.76rem;font-weight:700;padding:6px 18px;border-radius:50px;white-space:nowrap;box-shadow:var(--sombra)}
.plano h3{font-size:1.3rem;font-weight:700;margin-bottom:6px}
.plano .desc{font-size:.92rem;color:var(--cinza);margin-bottom:20px;min-height:42px}
.plano .de{font-size:.92rem;color:var(--cinza-claro);text-decoration:line-through;margin-bottom:2px}
.plano .preco{display:flex;align-items:flex-end;gap:5px;margin-bottom:6px}
.plano .preco .cifrao{font-size:1.1rem;font-weight:700;color:var(--grafite);margin-bottom:6px}
.plano .preco .valor{font-family:'Raleway';font-size:2.8rem;font-weight:800;line-height:1;color:var(--preto)}
.plano .preco .mes{font-size:.95rem;color:var(--cinza);margin-bottom:7px}
.plano .barato{font-size:.82rem;color:var(--cinza-claro);margin-bottom:26px;min-height:20px}
.plano ul{list-style:none;display:flex;flex-direction:column;gap:12px;margin-bottom:28px;flex:1}
.plano li{display:flex;align-items:flex-start;gap:11px;font-size:.94rem;color:var(--grafite)}
.plano li svg{width:19px;height:19px;color:var(--laranja);flex-shrink:0;margin-top:2px}
.plano .btn{width:100%}

/* DEPOIMENTOS */
.depos{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.depo{background:#fff;border-radius:var(--radius);padding:28px;box-shadow:0 18px 44px -30px rgba(0,0,0,.2);border:1px solid rgba(255,90,31,.07)}
.stars{display:flex;gap:3px;margin-bottom:14px}
.stars svg{width:18px;height:18px;color:var(--amarelo)}
.depo p{font-size:.96rem;color:var(--grafite);margin-bottom:18px;font-style:italic}
.depo .who{display:flex;align-items:center;gap:12px}
.depo .av{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,var(--laranja),var(--amarelo));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-family:'Raleway';font-size:1.1rem}
.depo .who b{display:block;font-size:.95rem;font-weight:600}
.depo .who span{font-size:.81rem;color:var(--cinza)}

/* FAQ */
.faq-wrap{max-width:780px;margin:0 auto;display:flex;flex-direction:column;gap:13px}
.faq-item{background:#fff;border-radius:16px;border:1px solid rgba(255,90,31,.1);overflow:hidden;box-shadow:0 12px 34px -28px rgba(0,0,0,.2)}
.faq-q{width:100%;text-align:left;background:none;border:none;cursor:pointer;padding:20px 22px;font-family:'Outfit';font-weight:600;font-size:1.03rem;color:var(--preto);display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-q .ic{width:28px;height:28px;border-radius:50%;background:var(--creme);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:transform .3s;color:var(--laranja);font-size:1.3rem;line-height:1}
.faq-item.open .faq-q .ic{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease}
.faq-a p{padding:0 22px 20px;color:var(--cinza);font-size:.97rem}

/* STATS */
.stats{background:linear-gradient(120deg,var(--laranja),var(--laranja-escuro) 60%,var(--vermelho));padding:54px 0;color:#fff}
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
.stat b{font-family:'Raleway';font-size:2.6rem;font-weight:900;display:block;line-height:1}
