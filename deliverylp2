.foot-social{display:flex;gap:12px}
.foot-social a{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;transition:background .2s}
.foot-social a:hover{background:var(--laranja)}
.foot-social svg{width:18px;height:18px;color:#fff}
.foot-copy{text-align:center;padding-top:24px;font-size:.83rem;color:rgba(255,255,255,.5)}

/* WHATSAPP FLOAT */
.zap-float{position:fixed;bottom:24px;right:24px;z-index:900;display:flex;align-items:center;gap:11px;background:var(--verde-zap);color:#fff;padding:13px 20px 13px 14px;border-radius:50px;box-shadow:0 16px 40px -14px rgba(37,211,102,.7);font-weight:600;font-size:.95rem;transition:transform .25s}
