.cta-final .btn{position:relative;z-index:2}

/* FOOTER */
footer{background:var(--preto);color:#fff;padding:50px 0 28px}
.foot-grid{display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap;padding-bottom:28px;border-bottom:1px solid rgba(255,255,255,.1)}
